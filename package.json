{
  "name": "autokala-store",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:server": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "admin": "node server/admin.mjs",
    "backup": "node server/backup.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
