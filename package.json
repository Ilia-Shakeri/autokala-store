{
  "name": "autokala-store",
  "private": true,
  "version": "1.2.0",
  "engines": {
    "node": ">=22.23.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:server": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:frontend": "vitest run --config vitest.config.ts",
    "demo": "node server/demo.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "admin": "node server/admin.mjs",
    "backup": "node server/backup.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@radix-ui/react-select": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.5"
  }
}
